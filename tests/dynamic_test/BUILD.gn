import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

# C29 vertical MVP test (§18): boot the kernel, seed the hello PIE and the
# libc DSO into the root tmpfs, then launch the dynamic application twice
# through the full ApplicationService path (first launch loads libc.so.1,
# second imports the Ready instance) and assert the oracle output lines.

build_rust("dynamic_test") {
  testonly = true
  crate_type = "bin"
  edition = "2021"
  sources = [ "src/test.rs" ]
  deps = [
    "//external/vendor/semihosting-0.1.20:semihosting",
    "//kernel/kernel:blueos",
    "//kernel/loader:blueos_loader",
    "//kernel/rsrt",
    "//libc",
    "//librs",
    ":dynamic_test_paths",
  ]
  linker_script = default_linker_script
  proc_macro_deps = [ "//kernel/test_harness:blueos_test_macro" ]
  rustflags = [ "--test" ]
}

# Absolute host paths of the built artifacts, compiled into the image as
# static strings so the semihosting reader can open them at runtime.
postlink_action("gen_hello_path_symbol") {
  testonly = true
  exe = "//apps/example/dynamic/hello:hello"
  script = "//kernel/loader/tests/scripts/gen_path_symbol.py"
  outfile = "${target_gen_dir}/${target_name}.c"
  args = [
    "DYNAMIC_HELLO_ELF_PATH",
    rebase_path(outfile),
  ]
  outputs = [ outfile ]
}

# The DSO lives under lib/, not bin/, so the postlink_action wrapper does not
# fit; spell the action directly against lib/liblibrs.so.
action("gen_libc_path_symbol") {
  testonly = true
  script = "//kernel/loader/tests/scripts/gen_path_symbol.py"
  deps = [ "//librs:libc" ]
  outfile = "${target_gen_dir}/${target_name}.c"
  args = [
    rebase_path("${root_out_dir}/lib/liblibrs.so"),
    "LIBC_SO_1_PATH",
    rebase_path(outfile),
  ]
  outputs = [ outfile ]
}

static_library("dynamic_test_paths") {
  testonly = true
  deps = [
    ":gen_hello_path_symbol",
    ":gen_libc_path_symbol",
  ]
  sources = get_target_outputs(":gen_hello_path_symbol") +
            get_target_outputs(":gen_libc_path_symbol")
}

gen_qemu_runner("dynamic_test_runner") {
  testonly = true
  img = ":dynamic_test"
  qemu = qemu_exe
  machine = qemu_machine
  semihosting = true
  qemu_args = qemu_extra_args
  block_img = "dynamic_test_block.img"
  block_args = qemu_block_args
}

run_qemu_check("run_dynamic_test") {
  testonly = true
  runner = ":dynamic_test_runner"
  checker = "src/test.rs"
}
