import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

group("check_loader") {
  testonly = true
  deps = [
    ":run_loader_unittest(//build/toolchain:host)",
    "tests:run_loader_integration_test",
  ]
}

group("check_loader_host") {
  testonly = true
  deps = [ ":run_loader_unittest" ]
}

group("inputs") {
  testonly = true
  deps = [ "tests/inputs" ]
}

if (coverage || profile) {
  build_rust("common_cov") {
    crate_type = "rlib"
    sources = [ "tests/cov/lib.rs" ]
    deps = [
      "//external/vendor/minicov-0.3.7:minicov",
      "//external/vendor/semihosting-0.1.20:semihosting",
    ]
  }
}

build_rust("blueos_loader") {
  crate_type = "rlib"
  sources = [
    "src/address.rs",
    "src/error.rs",
    "src/identity.rs",
    "src/image/layout.rs",
    "src/image/loaded.rs",
    "src/image/mod.rs",
    "src/image/parser.rs",
    "src/lib.rs",
    "src/limits.rs",
    "src/memory.rs",
    "src/memory_mapper.rs",
    "src/reader.rs",
  ]
  deps = [
    "//external/vendor/goblin-0.9.3:goblin",
    "//kernel/infra:blueos_infra",
    "//librs",
  ]
}

build_rust("loader_unittest") {
  testonly = true
  crate_name = "loader_unittest"
  crate_type = "bin"
  edition = "2021"
  sources = [
    "src/address.rs",
    "src/error.rs",
    "src/identity.rs",
    "src/image/layout.rs",
    "src/image/loaded.rs",
    "src/image/mod.rs",
    "src/image/parser.rs",
    "src/lib.rs",
    "src/limits.rs",
    "src/memory.rs",
    "src/memory_mapper.rs",
    "src/reader.rs",
    "src/tests.rs",
    "src/tests/fixture.rs",
  ]
  deps = [
    "//external/vendor/goblin-0.9.3:goblin",
    "//kernel/infra:blueos_infra",
  ]
  rustflags = [ "--test" ]
}

run_host("run_loader_unittest") {
  testonly = true
  runner = ":loader_unittest"
}

run_clippy("blueos_loader_clippy") {
  deps = [ ":blueos_loader" ]
}

group("check_loader_by_clippy") {
  testonly = true
  deps = [
    ":blueos_loader_clippy",
    "tests/integration_test:loader_integration_test_clippy",
  ]
  if (coverage || profile) {
    deps += [ ":common_cov" ]
  }
}
