}

# Give B a link-time provider with A's SONAME. The test installs the real A
# and B in VFS so the ELF dependency graph closes the cycle at runtime.
linked_test_library("linked_cycle_a_bootstrap") {
  sources = [ "cycle_a_bootstrap.c" ]
  output_dir = "$root_out_dir/lib/linked_cycle_bootstrap"
  output_name = "linked_cycle_a"
}

linked_test_library("linked_cycle_b") {
  sources = [ "cycle_b.c" ]
  deps = [ ":linked_cycle_a_bootstrap" ]
}

linked_test_library("linked_cycle_a") {
  sources = [ "cycle_a.c" ]
  deps = [ ":linked_cycle_b" ]
}

template("linked_test_executable") {
  build_rust(target_name) {
    testonly = true
    crate_type = "bin"
    sources = [ "main.rs" ]
    forward_variables_from(invoker, [ "cfgs" ])
    configs += [ "//build/boards/${board}:app_config" ]
    deps = [
      "//libs/librs:crt1",
      "//libs/librs:librs_swi",
    ]
    rustflags = [
      "-Cpanic=abort",
      "-Crelocation-model=pic",
      "-Clink-arg=-nostartfiles",
      "-Clink-arg=-Wl,-pie",
      "-Clink-arg=-Wl,--no-dynamic-linker",
      "-Clink-arg=-Wl,-u,_start",
      "-Clink-arg=-Wl,-e,_start",
      "-Clink-arg=-Wl,-z,now",
      "-Clink-arg=-Wl,-z,noexecstack",
      "-Clink-arg=-Wl,--export-dynamic-symbol=record_event",
      "-Clink-arg=-Wl,--export-dynamic-symbol=linked_choice",
      "-Clink-arg=-Wl,--export-dynamic-symbol=__emutls_get_address",
    ]
    foreach(library, invoker.libraries) {
      deps += [ ":$library" ]
      library_path = "$root_out_dir/lib/lib${library}.so"
      rustflags += [ "-Clink-arg=" + rebase_path(library_path, root_build_dir) ]
    }
    if (current_cpu == "aarch64") {
      inputs = [ _exports_script ]
      rustflags += [
        "-Clink-arg=" + _exports_flag,
        "-Clink-arg=-Wl,-rpath-link," +
            rebase_path("$root_out_dir/lib", root_build_dir),
      ]
    }
  }
}

linked_test_executable("linked_test_app") {
  libraries = [ "linked_test_dso" ]
}

linked_test_executable("linked_graph_app") {
  cfgs = [ "linked_startup_graph" ]
  libraries = [
    "linked_test_dso",
    "linked_chain_plugin",
    "linked_cycle_a",
  ]
}

run_clippy("linked_test_app_clippy") {
  testonly = true
  deps = [
    ":linked_graph_app",
    ":linked_test_app",
  ]
}

postlink_action("app_path") {
  testonly = true
  exe = ":linked_test_app"
  script = "//kernel/loader/tests/scripts/gen_path_symbol.py"
  outfile = "${target_gen_dir}/${target_name}.c"
  args = [
    "LINKED_TEST_APP_PATH",
    rebase_path(outfile),
  ]
  outputs = [ outfile ]
}

postlink_action("graph_app_path") {
  testonly = true
  exe = ":linked_graph_app"
  script = "//kernel/loader/tests/scripts/gen_path_symbol.py"
  outfile = "${target_gen_dir}/${target_name}.c"
  args = [
    "LINKED_GRAPH_APP_PATH",
    rebase_path(outfile),
  ]
  outputs = [ outfile ]
}

template("linked_test_library_path") {
  action(target_name) {
    testonly = true
    script = "//kernel/loader/tests/scripts/gen_path_symbol.py"
    deps = [ ":${invoker.library}" ]
    library_path = "$root_out_dir/lib/lib${invoker.library}.so"
    inputs = [ library_path ]
    outfile = "${target_gen_dir}/${target_name}.c"
    args = [
      rebase_path(library_path, root_build_dir),
      invoker.symbol,
      rebase_path(outfile),
    ]
    outputs = [ outfile ]
  }
}

