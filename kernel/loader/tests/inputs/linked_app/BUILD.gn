static_library("paths") {
  testonly = true
  path_actions = [
    ":app_path",
    ":chain_leaf_path",
    ":chain_middle_path",
    ":chain_peer_path",
    ":chain_plugin_path",
    ":cycle_a_path",
    ":cycle_b_path",
    ":dso_path",
    ":graph_app_path",
    ":plugin_path",
    ":scope_cpp_path",
    ":scope_path",
    ":unresolved_plugin_path",
  ]
  deps = path_actions
  sources = []
  foreach(path_action, path_actions) {
    sources += get_target_outputs(path_action)
  }
}
