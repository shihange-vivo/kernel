import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

if (current_cpu == "aarch64") {
  _exports_script = "exports.map"
  _exports_flag =
      "-Wl,--version-script=" + rebase_path(_exports_script, root_build_dir)
}

template("linked_test_library") {
  shared_library(target_name) {
    testonly = true
    forward_variables_from(invoker,
                           [
                             "sources",
                             "deps",
                             "output_dir",
                             "output_name",
                           ])
    cflags = [
      "-fPIC",
      "-ffreestanding",
      "-fno-stack-protector",
    ]
    if (defined(invoker.cflags_cc)) {
      cflags_cc = invoker.cflags_cc
    }
    ldflags = [
      "-nostdlib",
      "-Wl,-z,now",
    ]
    if (current_cpu == "aarch64") {
      inputs = [ _exports_script ]
      ldflags += [ _exports_flag ]
    }
    if (current_cpu == "riscv32" || current_cpu == "riscv64") {
      # The bare-metal Clang driver needs a linker-specific -shared.
      ldflags += [
        "-fuse-ld=lld",
        "-Wl,-shared",
        "-Wl,-Bdynamic",
      ]
    }
  }
}

linked_test_library("linked_test_dso") {
  sources = [ "provider.c" ]
}

linked_test_library("linked_test_plugin") {
  sources = [ "plugin.c" ]
  deps = [ ":linked_test_dso" ]
}

linked_test_library("linked_unresolved_plugin") {
  sources = [ "unresolved_plugin.c" ]
}

linked_test_library("linked_scope_cpp") {
  sources = [ "scope_cpp.cc" ]
  cflags_cc = [
    "-fno-exceptions",
    "-fno-rtti",
  ]
}

linked_test_library("linked_scope") {
  sources = [ "scope.c" ]
  deps = [ ":linked_scope_cpp" ]
}

linked_test_library("linked_chain_leaf") {
  sources = [ "chain_leaf.c" ]
}

linked_test_library("linked_chain_middle") {
  sources = [ "chain_middle.c" ]
  deps = [ ":linked_chain_leaf" ]
}

linked_test_library("linked_chain_peer") {
  sources = [ "chain_peer.c" ]
  deps = [ ":linked_chain_leaf" ]
}

linked_test_library("linked_chain_plugin") {
  sources = [ "chain_plugin.c" ]
  deps = [
    ":linked_chain_middle",
    ":linked_chain_peer",
