import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

_kernel_default_cfgs = [
  "scheduler=\"global\"",
  "${build_type}",
]

group("check_kernel") {
  testonly = true
  deps = [
    ":run_integration_test",
    ":run_unittest",
  ]
}

group("check_kernel_by_clippy") {
  testonly = true
  deps = [
    ":blueos_clippy",
    ":kernel_integration_test_clippy",
    ":kernel_unittest_clippy",
    "//external/rust:semihosting",
  ]
}

group("check_kernel_probe") {
  testonly = true
  deps = [ ":run_unittest" ]
}

_shared_deps = [
  "//external/rust:bitflags",
  "//external/rust:cfg-if",
  "//external/rust:const-default",
  "//external/rust:embedded-hal",
  "//external/rust:embedded-hal-bus",
  "//external/rust:embedded-io",
  "//external/rust:heapless",
  "//external/rust:log",
  "//external/rust:mipidsi",
  "//external/rust:num-traits",
  "//external/rust:safe-mmio",
  "//external/rust:spin",
  "//external/rust:thiserror",
  "//external/rust:tock-registers",
  "//external/rust:zerocopy",
  "//external/rust-fatfs/v0.4:fatfs",
  "//kernel/allocator:allocator_crate",
  "//kernel/arch:arch_crate",
  "//kernel/core_traits",
  "//kernel/driver:blueos_driver",
  "//kernel/hal:blueos_hal",
  "//kernel/header:blueos_header",
  "//kernel/infra:blueos_infra",
  "//kernel/kconfig:blueos_kconfig",
  "//kernel/kconfig:generate_rustflags_file",
  "//libs/libc",
]

if (defined(dynamic_loader) && dynamic_loader) {
  _shared_deps += [ "//kernel/loader:blueos_loader" ]
}

# GCC provides __atomic builtins natively; skip the clang-derived libatomic for
# GCC toolchains.
if (current_toolchain != "//build/toolchain:gcc_fv_thumbv8m") {
  _shared_deps += [ ":atomic" ]
}
_shared_deps += board_deps

if (coverage || profile) {
  _shared_deps += [
    "//external/rust:minicov",
    "//external/rust:semihosting",
  ]
}

build_rust("kernel_unittest") {
  testonly = true
  crate_name = "kernel_unittest"
  crate_type = "bin"
  sources = [ "src/lib.rs" ]
  edition = "2021"
  proc_macro_deps = [
    "//external/rust:delegate",
    "//external/rust:num-derive",
    "//external/rust:paste",
    "//kernel/macro:blueos_macro",
    "//kernel/test_harness:blueos_test_macro",
  ]
  rustenv = [ "TARGET_BOARD=${board}" ]
  cfgs = _kernel_default_cfgs
  deps = _shared_deps
  deps += [ "//external/rust:semihosting" ]
  configs += [
    "//kernel/kconfig:kconfigs",
    "//build/boards/${board}:kernel_config",
  ]
  rustflags = [
    "--test",
    "-Zpanic-abort-tests",
  ]
  linker_script = default_linker_script
  if (defined(chip)) {
    rustflags += [
      "--cfg",
      "target_chip=\"${chip}\"",
    ]
  }
}

run_clippy("kernel_unittest_clippy") {
  testonly = true
  deps = [ ":kernel_unittest" ]
}

build_rust("kernel_integration_test") {
  testonly = true
  crate_type = "bin"
  sources = [ "tests/integration_test.rs" ]
  edition = "2021"
  proc_macro_deps = [ "//kernel/test_harness:blueos_test_macro" ]
  deps = [
           ":blueos",
           "//external/rust:byteorder",
           "//external/rust:semihosting",
           "//kernel/infra:blueos_infra",
           "//kernel/rsrt",
           "//kernel/scal:blueos_scal",
           "//libs/libc",
         ] + board_deps
  if (coverage || profile) {
    deps += [ "//external/rust:minicov" ]
  }
  cfgs = _kernel_default_cfgs
  linker_script = default_linker_script
  rustflags = [
    "--test",
    "-Zpanic-abort-tests",
  ]
  if (defined(chip)) {
    rustflags += [
      "--cfg",
      "target_chip=\"${chip}\"",
    ]
  }
}

run_clippy("kernel_integration_test_clippy") {
  testonly = true
  deps = [ ":kernel_integration_test" ]
}

build_rust("blueos") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2021"
  proc_macro_deps = [
    "//external/rust:delegate",
    "//external/rust:num-derive",
    "//external/rust:paste",
    "//kernel/macro:blueos_macro",
  ]
  rustenv = [ "TARGET_BOARD=${board}" ]
  cfgs = _kernel_default_cfgs
  deps = _shared_deps
  public_deps = board_deps
  public_deps += [ "//kernel/kconfig:generate_rustflags_file" ]
  if (defined(dynamic_loader) && dynamic_loader) {
    cfgs += [ "dynamic_loader" ]
  }
  if (defined(boot_dynamic_seed) && boot_dynamic_seed) {
    # Catalog only: it holds VFS paths and host paths, not artifact bytes.
    deps += [ ":boot_seed_catalog" ]
    cfgs += [ "boot_dynamic_seed" ]
  }
  public_configs += [
    "//kernel/kconfig:kconfigs",
    "//build/boards/${board}:kernel_config",
  ]
}

run_clippy("blueos_clippy") {
  deps = [ ":blueos" ]
}

# Build the bootable kernel image whose sole static application installs the
# boot system image and launches the dynamic bootstrap shell. Keeping both in
# the dedicated image prevents unrelated QEMU test binaries from also seeding a
# root and running an interactive shell.
#
# The system image is *not* embedded here: `gen_boot_seed_files` records where
# each artifact lives on the host, and boot streams the bytes into the root
# tmpfs over semihosting. The kernel image therefore carries no application
# bytes at all.
# Gated per board via `boot_dynamic_seed` (currently qemu_mps2_an385).
if (defined(boot_dynamic_seed) && boot_dynamic_seed) {
  build_rust("kernel_image") {
    crate_type = "bin"
    edition = "2021"
    sources = [ "src/kernel_image.rs" ]
    deps = [
      ":blueos",
      "//kernel/rsrt",
      "//libs/libc",
      "//libs/librs",
    ]

    # The board runners read the generated rustflags file, so the kconfig
    # generation must be reachable through public deps.
    public_deps = [ "//kernel/kconfig:generate_rustflags_file" ]
    cfgs = _kernel_default_cfgs
    linker_script = default_linker_script
    public_configs += [
      "//kernel/kconfig:kconfigs",
      "//build/boards/${board}:kernel_config",
    ]
  }

  _clang_c_layout =
      "${root_gen_dir}/example/dynamic/clang_c/clang_c_layout.json"
  _clang_cxx_layout =
      "${root_gen_dir}/example/dynamic/clang_cxx/clang_cxx_layout.json"
  _multi_layout = "${root_gen_dir}/example/dynamic/multi_dso/multi_layout.json"
  _cycle_layout =
      "${root_gen_dir}/example/dynamic/cycle_demo/cycle_demo_layout.json"
  _scope_layout =
      "${root_gen_dir}/example/dynamic/scope_demo/scope_demo_layout.json"
  _scope_bad_layout =
      "${root_gen_dir}/example/dynamic/scope_bad/scope_bad_layout.json"
  _tls_layout = "${root_gen_dir}/example/dynamic/tls_demo/tls_demo_layout.json"

  _boot_seed_catalog = "${target_gen_dir}/boot_seed_catalog.rs"

  action("gen_boot_seed_files") {
    script = "//build/scripts/gen_boot_seed_files.py"
    deps = [
      "//example/dynamic/clang_c:clang_c_layout",
      "//example/dynamic/clang_cxx:clang_cxx_layout",
      "//example/dynamic/cycle_demo:cycle_demo_layout",
      "//example/dynamic/hello",
      "//example/dynamic/multi_dso:multi_layout",
      "//example/dynamic/rust_std",
      "//example/dynamic/scope_bad:scope_bad_layout",
      "//example/dynamic/scope_demo:scope_demo_layout",
      "//example/dynamic/scope_demo:scope_sys",
      "//example/dynamic/tls_demo:tls_demo_layout",
      "//libs/librs:libc",
      "//shell",
    ]
    inputs = [
      "${root_out_dir}/bin/hello",
      "${root_out_dir}/bin/rust_std",
      "${root_out_dir}/bin/shell",
      "${root_out_dir}/lib/liblibrs.so",
      "${root_out_dir}/lib/libscope_sys.so",
      _clang_c_layout,
      _clang_cxx_layout,
      _multi_layout,
      _cycle_layout,
      _scope_layout,
      _scope_bad_layout,
      _tls_layout,
    ]

    # Fixed files and application bundle layouts share one source of truth.
    # `inputs` above only orders the artifact targets ahead of the boot image;
    # the generated catalog records their paths, never their bytes.
    args = [
      "--catalog-out",
      rebase_path(_boot_seed_catalog),
      "--file",
      "/apps/hello/app.elf," + rebase_path("${root_out_dir}/bin/hello"),
      "--file",
      "/apps/rust_std/app.elf," + rebase_path("${root_out_dir}/bin/rust_std"),
      "--file",
      "/shell/app.elf," + rebase_path("${root_out_dir}/bin/shell"),
      "--file",
      "/system/lib/libc.so.1," + rebase_path("${root_out_dir}/lib/liblibrs.so"),
      "--file",
      "/system/lib/libscope_sys.so.1," +
          rebase_path("${root_out_dir}/lib/libscope_sys.so"),
      "--layout",
      rebase_path(_clang_c_layout),
      "--layout",
      rebase_path(_clang_cxx_layout),
      "--layout",
      rebase_path(_multi_layout),
      "--layout",
      rebase_path(_cycle_layout),
      "--layout",
      rebase_path(_scope_layout),
      "--layout",
      rebase_path(_scope_bad_layout),
      "--layout",
      rebase_path(_tls_layout),
    ]
    outputs = [ _boot_seed_catalog ]
  }

  build_rust("boot_seed_catalog") {
    crate_type = "rlib"
    sources = [ _boot_seed_catalog ]
    edition = "2021"
    deps = [ ":gen_boot_seed_files" ]
  }
}

cbindgen("rust_wrapper") {
  sources = [ "cbindgen.toml" ]
  args = [
           "--quiet",
           "-c",
         ] + rebase_path([ "cbindgen.toml" ], root_build_dir) +
         rebase_path([ "." ], root_build_dir)
}

if (defined(qemu_use_esp32_loader) && qemu_use_esp32_loader) {
  gen_esp32_qemu_runner("integration_test_runner") {
    testonly = true
    elf = ":kernel_integration_test"
    chip = "${chip}"
    bootloader = qemu_esp32_bootloader_bin
    partition_table = qemu_esp32_partition_table_bin
    qemu = qemu_exe
    machine = qemu_machine
    qemu_args = qemu_extra_args
    net_args = qemu_net_args
    block_args = qemu_block_args
    semihosting = true
  }
} else {
  gen_qemu_runner("integration_test_runner") {
    testonly = true
    semihosting = true
    img = ":kernel_integration_test"
    qemu = qemu_exe
    machine = qemu_machine
    qemu_args = qemu_extra_args
    net_args = qemu_net_args
    block_img = "integration_test_block.img"
    block_args = qemu_block_args
  }
}

run_qemu_check("run_integration_test") {
  testonly = true
  runner = ":integration_test_runner"
  if (coverage) {
    img = ":kernel_integration_test"
    checker = "src/coverage.checker"
  } else {
    checker = "tests/integration.checker"
  }
}

if (defined(use_defmt) && use_defmt) {
  gen_probe_runner("unittest_runner") {
    testonly = true
    img = ":kernel_unittest"
    chip = "$chip"
  }
} else if (defined(qemu_use_esp32_loader) && qemu_use_esp32_loader) {
  gen_esp32_qemu_runner("unittest_runner") {
    testonly = true
    elf = ":kernel_unittest"
    chip = "${chip}"
    bootloader = qemu_esp32_bootloader_bin
    partition_table = qemu_esp32_partition_table_bin
    qemu = "$qemu_exe"
    machine = "$qemu_machine"
    qemu_args = qemu_extra_args
    block_args = qemu_block_args
    semihosting = true
  }
} else {
  gen_qemu_runner("unittest_runner") {
    testonly = true
    img = ":kernel_unittest"
    qemu = "$qemu_exe"
    machine = "$qemu_machine"
    qemu_args = qemu_extra_args
    block_img = "unittest_block.img"
    block_args = qemu_block_args
    semihosting = true
  }
}

run_qemu_check("run_unittest") {
  testonly = true
  runner = ":unittest_runner"
  if (coverage) {
    img = ":kernel_unittest"
    checker = "src/coverage.checker"
  } else {
    checker = "src/unittests.checker"
  }
}

static_library("atomic") {
  sources = [ "src/sync/libatomic/atomic.c" ]
}
